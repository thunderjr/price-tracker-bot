# From @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to command the bot.
# Ask @userinfobot for yours. Without this the bot answers nobody.
ALLOWED_CHAT_IDS=

# How often every active watch is rescanned. Keep this generous: this is a
# personal tracker, and low volume is what keeps the scrapers working.
SCAN_INTERVAL=3h

# Alert when a price falls this far below its own 30-day median.
DROP_THRESHOLD=0.10

# How far a watch's best price must move before you hear about it, in either
# direction. 0.01 = 1%. Lower it and cent-level wobble becomes a notification.
BEST_MOVE_THRESHOLD=0.01

LOG_LEVEL=info
